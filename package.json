{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "description": "Distributed Wagering Processor for Jungle Gaming Technical Challenge",
  "private": true,
  "scripts": {
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "test": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:all": "bun test test/",
    "test:load": "bun run test/load/load-test.ts",
    "typecheck": "tsc --noEmit",
    "migration:up": "bun run src/infrastructure/database/migrate.ts up",
    "migration:down": "bun run src/infrastructure/database/migrate.ts down"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.758.0",
    "@mikro-orm/core": "^6.4.8",
    "@mikro-orm/migrations": "^6.4.8",
    "@mikro-orm/nestjs": "^6.1.1",
    "@mikro-orm/postgresql": "^6.4.8",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/terminus": "^10.2.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/uuid": "^10.0.0",
    "bun-types": "latest",
    "typescript": "^5.7.3"
  }
}
